// CONTENT OS relational schema.
//
// Design notes:
//  - A Project is one product idea/brand under test. Everything is scoped to it.
//  - A ContentAsset is the uploaded media. A ContentVariant is one copy treatment
//    (hook/caption/hashtags/CTA) of that media. A Post pairs an asset+variant and
//    is what gets approved and scheduled. A PostPlatform is that post's fanout to
//    one social account, and is the unit that publishes and collects analytics.
//  - PublishJob is 1:1 with PostPlatform and carries a unique idempotency key so
//    the same content can never be published twice by a retry.
//  - AnalyticsSnapshot is append-only: history is never overwritten.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  EDITOR
  APPROVER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

/// How much human involvement a project's publishing requires.
enum PublishPolicy {
  MANUAL_APPROVAL
  AUTO_PUBLISH
  SMART_APPROVAL
}

enum Platform {
  TIKTOK
  INSTAGRAM
  YOUTUBE
}

enum AccountStatus {
  DISCONNECTED
  CONNECTED
  NEEDS_REAUTH
  /// The platform is showing a verification step only a person can clear.
  CHALLENGE
  ERROR
}

enum PlatformSessionStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum AssetKind {
  VIDEO
  IMAGE
}

enum AssetStatus {
  UPLOADED
  ANALYZING
  ANALYZED
  ANALYSIS_FAILED
  ARCHIVED
}

enum ContentFormat {
  TALKING_HEAD
  SCREEN_RECORDING
  TUTORIAL
  STORY
  COMPARISON
  LIST
  REACTION
  BUILD_IN_PUBLIC
  UNKNOWN
}

enum PostStatus {
  DRAFT
  READY
  APPROVED
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum PostPlatformStatus {
  PENDING
  QUEUED
  UPLOADING
  PUBLISHED
  FAILED
  SKIPPED
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD_LETTER
  /// Cannot run as things stand — e.g. the account was disconnected. Held
  /// rather than failed, because reconnecting makes it runnable again.
  BLOCKED
}

enum AttemptOutcome {
  SUCCESS
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
}

/// Normalised reason a publish attempt failed. Drives retry policy and is what
/// the operator sees, so it must be decided by the adapter rather than guessed
/// from an error string.
enum FailureCategory {
  AUTH_SESSION
  SELECTOR_DRIFT
  TRANSIENT
  PLATFORM_REJECTED
  MEDIA_REJECTED
  HUMAN_ACTION_REQUIRED
  BLOCKED_DISCONNECTED
  UNKNOWN
}

/// How a publish was actually carried out. Recorded per attempt and per
/// destination so a row's provenance is never inferred from configuration that
/// may since have changed.
enum AdapterMode {
  OFFICIAL_API
  BROWSER_ASSISTED
  SIMULATED
}

/// Furthest point a publish attempt reached. Makes "where did it die" a query
/// rather than a log-reading exercise.
enum PublishStage {
  QUEUED
  PREFLIGHT
  SESSION_RESTORED
  AUTHENTICATED
  COMPOSER_OPENED
  MEDIA_UPLOADED
  METADATA_ENTERED
  SUBMITTED
  CONFIRMED
  VERIFIED
}

/// Where a metric came from. Browser-assisted numbers are less trustworthy than
/// official API numbers and the UI labels them as such.
enum MetricSource {
  OFFICIAL_API
  BROWSER_ASSISTED
  MANUAL
  SIMULATED
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

enum RecommendationKind {
  DOUBLE_DOWN
  EXPERIMENT
  TIMING
  FORMAT
  CTA
}

enum RecommendationStatus {
  OPEN
  ACCEPTED
  DISMISSED
  SUPERSEDED
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  CONCLUDED
  ABANDONED
}

enum ExperimentRole {
  CONTROL
  VARIANT
}

enum TrendMomentum {
  RISING
  STEADY
  FALLING
}

enum ActorType {
  USER
  SYSTEM
  WORKER
}

/// Where a piece of evidence came from, and therefore how much inferential
/// weight it can carry. These are kept distinct for the whole life of a claim:
/// a global prior must never quietly become an account-proven learning.
enum EvidenceType {
  /// This brand's own published results, features, analytics and feedback.
  ACCOUNT_EVIDENCE
  /// General creative/platform knowledge the system ships with. Proposes what
  /// MAY work; proves nothing about this brand.
  GLOBAL_PRIOR
  /// Observations about the wider market: trends, competitors, benchmarks.
  EXTERNAL_EVIDENCE
  /// A controlled test run for this account, with a control and a variant.
  EXPERIMENT_EVIDENCE
}

/// How a piece of evidence bears on a claim.
enum EvidenceRelationship {
  SUPPORTS
  CONTRADICTS
  /// Neither supports nor contradicts; supplies context that shapes reading.
  CONTEXTUALIZES
}

/// Lifecycle of an account-specific learning. Nothing starts as truth.
enum LearningStatus {
  /// Proposed, not yet supported by account evidence.
  HYPOTHESIS
  /// Some supporting account evidence, below the reliability bar.
  EMERGING
  /// Enough consistent evidence to act on.
  SUPPORTED
  /// Contradictory evidence has accumulated against it.
  WEAKENED
  /// Replaced by a later learning.
  SUPERSEDED
}

/// Business goals a brand can optimise for. Deliberately not view-centric.
enum ObjectiveKind {
  REACH
  IMPRESSIONS
  WATCH_TIME
  RETENTION
  FOLLOWERS
  ENGAGEMENT
  PROFILE_VISITS
  WEBSITE_TRAFFIC
  LEADS
  BOOKINGS
  PURCHASES
  REVENUE
  CUSTOM
}

enum AwarenessStage {
  UNAWARE
  PROBLEM_AWARE
  SOLUTION_AWARE
  PRODUCT_AWARE
  MOST_AWARE
}

enum StrategyStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(OWNER)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions        UserSession[]
  uploadedAssets  ContentAsset[]   @relation("AssetUploader")
  createdVariants ContentVariant[] @relation("VariantAuthor")
  approvedPosts   Post[]           @relation("PostApprover")
  activity        ActivityLog[]
}

/// Opaque server-side session. Only a hash of the token is stored, so a database
/// leak does not hand out live sessions.
model UserSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Projects and brand context
// ---------------------------------------------------------------------------

/// Tenant boundary. A Workspace owns brands, their evidence and their learnings.
///
/// Naming note: in this codebase a `Project` IS a brand (one product idea under
/// test) and `Brand` is its profile. See docs/DOMAIN.md for the full map.
model Workspace {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  evidence  EvidenceSource[]
  learnings Learning[]
  aiJobs    AIJob[]
}

model Project {
  id            String        @id @default(cuid())
  workspaceId   String
  slug          String        @unique
  name          String
  description   String?
  status        ProjectStatus @default(ACTIVE)
  /// Hex accent used to colour-code the project across the UI.
  accentColor   String        @default("#6366f1")
  publishPolicy PublishPolicy @default(MANUAL_APPROVAL)
  timezone      String        @default("UTC")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand           Brand?
  objectives      BusinessObjective[]
  audiences       AudienceSegment[]
  strategies      StrategyVersion[]
  evidence        EvidenceSource[]
  learnings       Learning[]
  pillars         ContentPillar[]
  hashtags        Hashtag[]
  accounts        SocialAccount[]
  assets          ContentAsset[]
  posts           Post[]
  schedules       Schedule[]
  trends          Trend[]
  experiments     Experiment[]
  recommendations Recommendation[]
  activity        ActivityLog[]
  aiJobs          AIJob[]

  @@index([workspaceId])
}

/// The voice of a project. Kept separate from Project so brand copy can evolve
/// without touching operational fields.
model Brand {
  id            String   @id @default(cuid())
  projectId     String   @unique
  audience      String
  tone          String
  valueProp     String
  website       String?
  primaryCta    String
  bannedPhrases String[] @default([])

  // --- Identity (added in the intelligence phase; all optional so existing
  // --- brands remain valid without backfill).
  industry         String?
  productsServices String[] @default([])
  pricingNotes     String?
  geography        String?
  competitors      String[] @default([])
  differentiators  String[] @default([])
  /// Claims or topics this brand must never make. Enforced at copy generation.
  prohibitedTopics String[] @default([])
  visualStyle      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// A goal the brand is optimising for, with the KPI that measures it.
///
/// Deliberately a list rather than a single field: real brands trade reach off
/// against conversion, and the weighting is what lets performance analysis score
/// a post against what the business actually wants rather than against views.
model BusinessObjective {
  id                     String        @id @default(cuid())
  projectId              String
  kind                   ObjectiveKind
  /// The measurable series, e.g. "profileVisits" or "conversions".
  kpi                    String
  /// 1 = most important. Ties are allowed.
  priority               Int           @default(1)
  targetValue            Float?
  /// Relative pull in the objective score. Normalised at read time, so the
  /// absolute numbers here carry no meaning on their own.
  optimizationWeight     Float         @default(1)
  /// What this KPI genuinely cannot see, e.g. "no click attribution on TikTok".
  attributionLimitations String?
  active                 Boolean       @default(true)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, active])
}

/// One audience the brand is speaking to.
model AudienceSegment {
  id             String         @id @default(cuid())
  projectId      String
  name           String
  description    String?
  /// Only what the operator deliberately supplies. Never inferred.
  demographics   Json           @default("{}")
  pains          String[]       @default([])
  desires        String[]       @default([])
  objections     String[]       @default([])
  motivations    String[]       @default([])
  awarenessStage AwarenessStage @default(PROBLEM_AWARE)
  priority       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  strategies StrategyVersion[]

  @@index([projectId])
}

model ContentPillar {
  id          String   @id @default(cuid())
  projectId   String
  slug        String
  name        String
  description String?
  createdAt   DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assets  ContentAsset[]

  @@unique([projectId, slug])
  @@index([projectId])
}

model Hashtag {
  id         String   @id @default(cuid())
  projectId  String
  tag        String
  usageCount Int      @default(0)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, tag])
  @@index([projectId])
}

// ---------------------------------------------------------------------------
// Social accounts and browser sessions
// ---------------------------------------------------------------------------

model SocialAccount {
  id            String        @id @default(cuid())
  projectId     String
  platform      Platform
  handle        String
  displayName   String?
  status        AccountStatus @default(DISCONNECTED)
  externalId    String?
  lastCheckedAt DateTime?
  lastError     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session       PlatformSession?
  postPlatforms PostPlatform[]

  @@unique([projectId, platform, handle])
  @@index([projectId])
  @@index([platform, status])
}

/// An encrypted Playwright storageState. No passwords are ever stored: the
/// operator logs in by hand and we keep only the resulting session blob,
/// AES-256-GCM encrypted with SESSION_ENCRYPTION_KEY.
model PlatformSession {
  id              String                @id @default(cuid())
  socialAccountId String                @unique
  status          PlatformSessionStatus @default(ACTIVE)
  /// Storage key of the dedicated browser profile this session belongs to.
  /// Never the operator's personal Chrome profile.
  profileKey      String?
  cipherText      String
  iv              String
  authTag         String
  algorithm       String                @default("aes-256-gcm")
  capturedAt      DateTime              @default(now())
  lastVerifiedAt  DateTime?
  expiresAt       DateTime?

  account SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model ContentAsset {
  id               String      @id @default(cuid())
  projectId        String
  uploaderId       String?
  pillarId         String?
  kind             AssetKind
  status           AssetStatus @default(UPLOADED)
  title            String
  originalFilename String
  storageKey       String
  thumbnailKey     String?
  mimeType         String
  sizeBytes        Int
  /// Content hash. Uniqueness stops the same file entering one project twice.
  checksum         String
  durationSeconds  Float?
  width            Int?
  height           Int?
  aspectRatio      String?
  hasAudio         Boolean?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploader User?            @relation("AssetUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  pillar   ContentPillar?   @relation(fields: [pillarId], references: [id], onDelete: SetNull)
  analyses AIAnalysis[]
  variants ContentVariant[]
  posts    Post[]

  @@unique([projectId, checksum])
  @@index([projectId, status])
  @@index([createdAt])
}

/// One analysis run over an asset. Append-only so we can compare providers and
/// see how suggestions changed over time.
model AIAnalysis {
  id             String        @id @default(cuid())
  assetId        String
  provider       String
  model          String
  format         ContentFormat @default(UNKNOWN)
  topic          String?
  likelyAudience String?
  visualSummary  String?
  transcript     String?
  /// Full provider payload, kept for auditability.
  raw            Json
  createdAt      DateTime      @default(now())

  asset ContentAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
}

/// One copy treatment of an asset. Variants are the unit of experimentation.
model ContentVariant {
  id          String   @id @default(cuid())
  assetId     String
  createdById String?
  label       String
  hook        String
  caption     String
  hashtags    String[] @default([])
  cta         String
  isControl   Boolean  @default(false)
  /// AI heuristic scores (hook/clarity/curiosity/cta/trend). Not predictions.
  scorecard   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  asset              ContentAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdBy          User?               @relation("VariantAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  posts              Post[]
  experimentVariants ExperimentVariant[]

  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Scheduling and publishing
// ---------------------------------------------------------------------------

model Post {
  id             String        @id @default(cuid())
  projectId      String
  assetId        String
  variantId      String
  experimentId   String?
  status         PostStatus    @default(DRAFT)
  approvalState  ApprovalState @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?
  scheduledFor   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset      ContentAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  variant    ContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  experiment Experiment?    @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  approvedBy User?          @relation("PostApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  targets    PostPlatform[]

  @@index([projectId, status])
  @@index([scheduledFor])
  @@index([approvalState])
}

/// A post's delivery to one social account. Publishing and analytics both hang
/// off this row, because the same creative behaves differently per platform.
model PostPlatform {
  id                 String             @id @default(cuid())
  postId             String
  socialAccountId    String
  platform           Platform
  status             PostPlatformStatus @default(PENDING)
  remotePostId       String?
  permalink          String?
  publishedAt        DateTime?
  lastError          String?
  /// How this destination was published. Null until an attempt succeeds.
  adapterMode        AdapterMode?
  /// The platform's own id for the account at the moment of publishing.
  platformAccountId  String?
  /// Set only when publication was confirmed by platform-visible evidence, not
  /// merely by a successful button click.
  verifiedAt         DateTime?
  verificationMethod String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  post      Post                @relation(fields: [postId], references: [id], onDelete: Cascade)
  account   SocialAccount       @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  job       PublishJob?
  snapshots AnalyticsSnapshot[]

  @@unique([postId, socialAccountId])
  @@index([status])
  @@index([platform, publishedAt])
}

model Schedule {
  id        String   @id @default(cuid())
  projectId String
  name      String
  timezone  String   @default("UTC")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slots   ScheduleSlot[]

  @@index([projectId])
}

/// A recurring posting window, stored relationally rather than as a JSON blob so
/// the calendar and the recommendation engine can both query it.
model ScheduleSlot {
  id          String    @id @default(cuid())
  scheduleId  String
  /// 0 = Sunday .. 6 = Saturday
  dayOfWeek   Int
  /// Minutes past local midnight.
  minuteOfDay Int
  platform    Platform?

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek, minuteOfDay, platform])
  @@index([scheduleId])
}

/// Exactly one job per PostPlatform. `idempotencyKey` is unique, which is what
/// makes "never publish the same thing twice" a database guarantee rather than
/// an application convention.
model PublishJob {
  id             String    @id @default(cuid())
  postPlatformId String    @unique
  idempotencyKey String    @unique
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  runAt          DateTime
  startedAt      DateTime?
  finishedAt     DateTime?
  lastError      String?
  queueJobId     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  postPlatform PostPlatform     @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)
  attemptLog   PublishAttempt[]

  @@index([status, runAt])
}

model PublishAttempt {
  id              String           @id @default(cuid())
  jobId           String
  attemptNo       Int
  outcome         AttemptOutcome?
  /// Normalised failure reason. Null on success.
  failureCategory FailureCategory?
  /// Furthest stage reached before finishing or failing.
  stageReached    PublishStage     @default(QUEUED)
  adapterMode     AdapterMode?
  startedAt       DateTime         @default(now())
  finishedAt      DateTime?
  errorMessage    String?
  screenshotKey   String?
  /// Timestamped step log for the run, shown verbatim in the job drawer.
  steps           Json             @default("[]")

  job PublishJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attemptNo])
  @@index([jobId])
}

// ---------------------------------------------------------------------------
// Analytics and learning
// ---------------------------------------------------------------------------

/// Append-only metric capture. Multiple snapshots per post are expected; nothing
/// here is ever updated in place.
model AnalyticsSnapshot {
  id               String       @id @default(cuid())
  postPlatformId   String
  capturedAt       DateTime     @default(now())
  /// Age bucket at capture time: "1h", "24h", "7d", "30d".
  windowLabel      String
  source           MetricSource @default(SIMULATED)
  views            Int          @default(0)
  likes            Int          @default(0)
  comments         Int          @default(0)
  shares           Int          @default(0)
  saves            Int          @default(0)
  profileVisits    Int          @default(0)
  linkClicks       Int          @default(0)
  conversions      Int          @default(0)
  followerDelta    Int          @default(0)
  watchTimeSeconds Float        @default(0)
  /// 0..1 fraction of viewers reaching the end.
  completionRate   Float        @default(0)

  postPlatform PostPlatform @relation(fields: [postPlatformId], references: [id], onDelete: Cascade)

  @@unique([postPlatformId, windowLabel, capturedAt])
  @@index([postPlatformId, capturedAt])
  @@index([windowLabel])
}

model Trend {
  id               String        @id @default(cuid())
  projectId        String?
  platform         Platform
  topic            String
  momentum         TrendMomentum @default(STEADY)
  /// 0..1 relevance to the project's brand context.
  relevanceScore   Float         @default(0)
  recommendedAngle String?
  source           String
  observedAt       DateTime      @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, observedAt])
}

model Experiment {
  id              String           @id @default(cuid())
  projectId       String
  name            String
  hypothesis      String
  /// Metric the winner is decided on, e.g. "views" or "completionRate".
  metric          String           @default("views")
  status          ExperimentStatus @default(DRAFT)
  startedAt       DateTime?
  endedAt         DateTime?
  winnerVariantId String?
  conclusion      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variants ExperimentVariant[]
  posts    Post[]

  @@index([projectId, status])
}

model ExperimentVariant {
  id           String         @id @default(cuid())
  experimentId String
  variantId    String
  role         ExperimentRole

  experiment Experiment     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant    ContentVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([experimentId, variantId])
}

/// A concrete, evidence-backed suggestion. `evidence` always carries the numbers
/// the suggestion was derived from so the UI can show its work.
model Recommendation {
  id                  String               @id @default(cuid())
  projectId           String
  kind                RecommendationKind
  status              RecommendationStatus @default(OPEN)
  title               String
  rationale           String
  confidence          Confidence           @default(LOW)
  evidence            Json
  suggestedHook       String?
  suggestedFormat     ContentFormat?
  suggestedMinSeconds Int?
  suggestedMaxSeconds Int?
  /// Local-time posting window, minutes past midnight.
  windowStartMinute   Int?
  windowEndMinute     Int?
  /// Expected performance as a multiple of the project's median views.
  expectedLift        Float?
  sampleSize          Int                  @default(0)
  /// What produced it, so a prior-driven suggestion is never mistaken for one
  /// grounded in this account's own results.
  generatedBy         String?
  model               String?
  promptVersion       String?
  createdAt           DateTime             @default(now())

  project       Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// Traceable evidence links. Distinct from the legacy `evidence` JSON column,
  /// which holds the raw numbers a recommendation was derived from.
  evidenceLinks RecommendationEvidence[]

  @@index([projectId, status, confidence])
}

/**
 * What the publishing worker reports about itself.
 * The worker is a separate process, so the web app cannot know from its own
 * configuration whether publishing is actually live — and a UI that says
 * "simulation" while the worker publishes for real is worse than no UI at all.
 * The worker writes here on start and on every sweep; the console reads this
 * rather than its own environment.
 * Singleton: one row, id "worker".
 */
model WorkerStatus {
  id             String   @id
  livePublishing Boolean
  aiProvider     String
  queuePrefix    String
  startedAt      DateTime
  lastSeenAt     DateTime
  hostname       String?
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model ActivityLog {
  id         String    @id @default(cuid())
  projectId  String?
  userId     String?
  actorType  ActorType @default(SYSTEM)
  action     String
  message    String
  entityType String?
  entityId   String?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now())

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// Intelligence: evidence, learnings, strategy
//
// The central rule of this layer: evidence never loses its provenance. A global
// prior stays a prior forever; it can inform a recommendation, but it can never
// become "what works for this brand". Only account and experiment evidence can
// do that, and only with enough sample behind them.
// ---------------------------------------------------------------------------

/// One observation that can bear on a strategic claim.
///
/// Deliberately one table with a discriminating `type` rather than four tables:
/// every consumer has to weigh these against each other, and a single queryable
/// surface is what makes that possible. The type is never erased.
model EvidenceSource {
  id          String       @id @default(cuid())
  workspaceId String
  /// Null for workspace-wide evidence such as a shipped global prior.
  projectId   String?
  type        EvidenceType

  /// What produced it: "PostPlatform", "Experiment", "StaticPrior", "UserFeedback".
  sourceEntityType String
  sourceEntityId   String?
  /// Which knowledge provider supplied it, for priors and external evidence.
  provider         String?

  /// Human-readable statement of what this observation shows.
  claim     String
  /// Creative/distribution dimension: "hook", "format", "timing", "length", "cta".
  dimension String?
  /// The group within that dimension, e.g. "problem_solution".
  groupKey  String?

  metric     String
  value      Float?
  /// What `value` is compared against, when there is a baseline.
  baseline   Float?
  /// Relative effect: (value - baseline) / baseline. Sign carries direction.
  effectSize Float?
  sampleSize Int    @default(0)
  /// 0..1 as asserted by the producer. Weighting reads this; it does not trust
  /// it on its own.
  confidence Float  @default(0)

  observedAt DateTime
  /// External evidence goes stale; priors do not. Null means no expiry.
  expiresAt  DateTime?

  platform  Platform?
  /// KPI this observation speaks to, when it is objective-specific.
  objective String?
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  learnings       LearningEvidence[]
  recommendations RecommendationEvidence[]
  strategies      StrategyEvidence[]

  @@index([workspaceId, type])
  @@index([projectId, dimension, groupKey])
  @@index([observedAt])
}

/// An account-specific claim that has earned its way up from hypothesis.
model Learning {
  id          String         @id @default(cuid())
  workspaceId String
  /// Null means workspace-wide rather than brand-specific.
  projectId   String?
  claim       String
  /// Where the claim applies: dimension, group, platform, objective.
  scope       Json           @default("{}")
  dimension   String?
  groupKey    String?
  metric      String
  status      LearningStatus @default(HYPOTHESIS)
  confidence  Confidence     @default(LOW)

  supportingCount    Int    @default(0)
  contradictingCount Int    @default(0)
  sampleSize         Int    @default(0)
  effectSize         Float?

  /// Set when a later learning replaces this one. History is never deleted.
  supersededById String?   @unique
  supersededBy   Learning? @relation("LearningSupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     Learning? @relation("LearningSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  evidence  LearningEvidence[]

  @@index([workspaceId, status])
  @@index([projectId, dimension, status])
}

model LearningEvidence {
  learningId       String
  evidenceSourceId String
  relationship     EvidenceRelationship @default(SUPPORTS)
  /// 0..1 contribution after weighting, recorded so the UI can show its work.
  strength         Float                @default(0)
  createdAt        DateTime             @default(now())

  learning Learning       @relation(fields: [learningId], references: [id], onDelete: Cascade)
  evidence EvidenceSource @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)

  @@id([learningId, evidenceSourceId])
  @@index([evidenceSourceId])
}

/// An immutable snapshot of the strategy at a point in time.
model StrategyVersion {
  id        String         @id @default(cuid())
  projectId String
  version   Int
  status    StrategyStatus @default(DRAFT)
  summary   String

  targetAudienceId     String?
  primaryObjectiveId   String?
  secondaryObjectiveId String?

  contentPillars      String[]   @default([])
  recommendedFormats  String[]   @default([])
  hookFamilies        String[]   @default([])
  narrativeStructures String[]   @default([])
  ctaStrategy         String?
  platformStrategy    Json       @default("{}")
  cadence             Json       @default("{}")
  hypotheses          Json       @default("[]")
  risks               Json       @default("[]")
  /// Snapshot of the account's state when this strategy was written.
  accountState        Json       @default("{}")
  confidence          Confidence @default(LOW)

  /// Which provider and prompt produced it, so output is always attributable.
  generatedBy   String
  model         String?
  promptVersion String?

  supersededById String?          @unique
  supersededBy   StrategyVersion? @relation("StrategySupersession", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes     StrategyVersion? @relation("StrategySupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project        Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targetAudience AudienceSegment?   @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  evidence       StrategyEvidence[]

  @@unique([projectId, version])
  @@index([projectId, status])
}

model StrategyEvidence {
  strategyVersionId String
  evidenceSourceId  String
  relationship      EvidenceRelationship @default(SUPPORTS)
  strength          Float                @default(0)
  /// Which strategy decision this evidence backs, e.g. "hookFamilies".
  decision          String?
  createdAt         DateTime             @default(now())

  strategyVersion StrategyVersion @relation(fields: [strategyVersionId], references: [id], onDelete: Cascade)
  evidence        EvidenceSource  @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)

  @@id([strategyVersionId, evidenceSourceId])
  @@index([evidenceSourceId])
}

model RecommendationEvidence {
  recommendationId String
  evidenceSourceId String
  relationship     EvidenceRelationship @default(SUPPORTS)
  strength         Float                @default(0)
  createdAt        DateTime             @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  evidence       EvidenceSource @relation(fields: [evidenceSourceId], references: [id], onDelete: Cascade)

  @@id([recommendationId, evidenceSourceId])
  @@index([evidenceSourceId])
}

// ---------------------------------------------------------------------------
// AI orchestration (Phase 2)
//
// Every model interaction in this system goes through one boundary and leaves
// two records behind: an AIJob describing what was asked and what came back,
// and one AIUsageLog per provider call — including repair attempts, because a
// repair costs money and hiding it would understate the true cost of a feature.
// ---------------------------------------------------------------------------

/// What kind of thing produced a result. Never inferred from the provider name.
enum AIProviderKind {
  /// Rule-based, local, no model call. Must never be presented as model output.
  DETERMINISTIC
  /// A hosted large language model.
  LLM
}

enum AIJobStatus {
  PENDING
  RUNNING
  /// Provider returned output that validated against the operation's schema.
  SUCCEEDED
  /// Provider answered, but never produced schema-valid output despite repair.
  INVALID_OUTPUT
  /// Provider errored — network, rate limit, refusal, overload.
  FAILED
  /// No provider was able to serve the request, e.g. no API key configured.
  UNAVAILABLE
}

/// The catalogue of things this system asks a model to do. A new operation is a
/// deliberate act: it needs a registered, versioned prompt and an output schema.
enum AIOperation {
  ASSET_ANALYSIS
  COPY_VARIANTS
  STRATEGY_DRAFT
  CONTENT_PLAN
  HOOK_REWRITE
  LEARNING_SUMMARY
}

/// One request through the AI boundary, from first attempt to typed result.
model AIJob {
  id          String      @id @default(cuid())
  workspaceId String
  projectId   String?
  operation   AIOperation
  status      AIJobStatus @default(PENDING)

  /// Which provider actually served it, and what class of thing it is.
  providerName String
  providerKind AIProviderKind
  /// Null for deterministic providers, which have no model.
  model        String?

  /// The registered prompt used. Version is part of the record so a change in
  /// wording is visible in the history rather than silently rewriting the past.
  promptName    String
  promptVersion String
  /// Hash of the rendered prompt, so identical text is provably identical.
  promptHash    String

  /// Hash of the typed input. Two jobs with the same hash asked the same thing.
  inputHash String
  /// The typed input as given to the boundary. Contains brand context, never secrets.
  input     Json   @default("{}")
  /// The validated, typed result. Null unless status is SUCCEEDED.
  output    Json?

  /// Total provider calls made, including repair attempts.
  attempts         Int  @default(0)
  /// How many of those were repair attempts after a validation failure.
  repairAttempts   Int  @default(0)
  /// Validation failures encountered, kept so bad schemas are debuggable.
  validationErrors Json @default("[]")

  /// Classified failure, e.g. RATE_LIMIT, TIMEOUT, INVALID_OUTPUT, UNAVAILABLE.
  errorKind String?
  /// Human-readable failure summary. Never contains credentials.
  error     String?

  /// Rolled up from AIUsageLog so listing jobs does not require an aggregate.
  inputTokens  Int   @default(0)
  outputTokens Int   @default(0)
  costUsd      Float @default(0)
  /// Wall-clock time across every attempt, in milliseconds.
  latencyMs    Int   @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  usage     AIUsageLog[]

  @@index([workspaceId, operation, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
  @@index([inputHash])
}

/// One provider call. A job with two repairs has three of these.
model AIUsageLog {
  id      String @id @default(cuid())
  aiJobId String
  /// 1-based. Attempt 1 is the original; later attempts are repairs or retries.
  attempt Int

  providerName String
  providerKind AIProviderKind
  model        String?

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)

  /// Computed from the provider's own price table at the time of the call, so a
  /// later price change does not rewrite what past work cost.
  costUsd   Float @default(0)
  latencyMs Int   @default(0)

  ok        Boolean @default(true)
  errorKind String?

  createdAt DateTime @default(now())

  job AIJob @relation(fields: [aiJobId], references: [id], onDelete: Cascade)

  @@unique([aiJobId, attempt])
  @@index([createdAt])
}
