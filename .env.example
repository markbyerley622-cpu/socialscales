# Which data source the frontend reads from.
#   mock  - local development fixtures (default, no backend required)
#   http  - the real Social Scales backend via HttpSocialScalesAdapter
SOCIAL_SCALES_DATA_MODE=mock

# Only used when SOCIAL_SCALES_DATA_MODE=http
# NEXT_PUBLIC_SOCIAL_SCALES_API_URL=http://localhost:4000
# SOCIAL_SCALES_API_TOKEN=
