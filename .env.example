# ---------------------------------------------------------------------------
# Social Scales — copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# Postgres. `npm run db:up` starts one on this port.
DATABASE_URL="postgresql://contentos:contentos@localhost:55432/contentos"

# BullMQ. The worker and the app must agree on this.
REDIS_URL="redis://localhost:56379"

# Generate both of these:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=""
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_COOKIE_SECRET=""

# The operator account the seed creates.
OPERATOR_EMAIL="operator@socialscales.local"
OPERATOR_PASSWORD=""
OPERATOR_NAME="Operator"

# Where uploaded media, renders and Playwright artefacts are written.
STORAGE_DIR="./storage"

# ---------------------------------------------------------------------------
# Dashboard data source
# ---------------------------------------------------------------------------
#   prisma - this app's own database, in process (default, no HTTP hop)
#   mock   - local fixtures, for UI work without a database
#   http   - a separate Social Scales backend via HttpSocialScalesAdapter
SOCIAL_SCALES_DATA_MODE=prisma

# Only used when SOCIAL_SCALES_DATA_MODE=http
# NEXT_PUBLIC_SOCIAL_SCALES_API_URL=http://localhost:4000
# SOCIAL_SCALES_API_TOKEN=

# ---------------------------------------------------------------------------
# AI orchestration
# ---------------------------------------------------------------------------
#   auto          use the language model when a key is set, else rules
#   deterministic always use rules, even with a key set
#   anthropic     require the model; fail rather than substituting
AI_MODEL_PROVIDER="auto"
AI_MODEL="claude-opus-5"

# Leave blank to run the whole system on rules. Nothing breaks without it;
# results are simply labelled as rule-generated.
ANTHROPIC_API_KEY=""

# Schema-repair attempts after an invalid generation, and transport retries.
AI_MAX_REPAIRS="2"
AI_MAX_RETRIES="2"
AI_REQUEST_TIMEOUT_MS="120000"

# Copy-suggestion provider for the pre-orchestration path.
AI_PROVIDER="heuristic"

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------
# FFmpeg and ffprobe must be on PATH, or point these at the binaries.
# FFMPEG_PATH="ffmpeg"
# FFPROBE_PATH="ffprobe"

# A .ttf used for burned-in captions. Auto-detected on Windows, macOS and Linux;
# set it explicitly if a render fails with FONT_UNAVAILABLE.
# RENDER_FONT_FILE="C:/Windows/Fonts/arialbd.ttf"

# ---------------------------------------------------------------------------
# Publishing
# ---------------------------------------------------------------------------
# Set to "1" to let the worker drive a real browser against real platforms.
# Left unset, the worker uses the built-in simulator, so the whole pipeline is
# exercisable without touching a live account.
ENABLE_LIVE_PUBLISHING="0"

# Show the browser window when connecting an account (recommended — you complete
# the sign-in by hand).
PLAYWRIGHT_HEADLESS="0"

# Fraction of first publish attempts the simulator fails (0..1). Non-zero keeps
# the retry path and the failure UI reachable in a demo install.
SIMULATED_FAILURE_RATE="0.125"

# Redis key namespace for the queues. The test suite overrides this.
QUEUE_PREFIX="bull"

# Overrides the derived <db>_test database used by the test suite.
# TEST_DATABASE_URL=
